package provider

import (
    "testing"

    "github.com/hashicorp/terraform-plugin-testing/helper/resource"
)

func TestAccDDNSDataSource(t *testing.T) {
    resource.Test(t, resource.TestCase{
        ProtoV6ProviderFactories: testAccProtoV6ProviderFactories,
        Steps: []resource.TestStep{
            {
                Config: providerConfig + `
data "allinkl_ddns" "provider_test" {
  dyndns_login = "dyn001c347"
}
`,
                Check: resource.ComposeAggregateTestCheckFunc(
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_login", "dyn001c347"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_comment", "gdqreminder"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_label", "gdqreminder.by.vincent"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_zone", "mahn.ke"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_dual_stack", "N"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "pwm", "N"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_password", ""),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_target_ip", "88.99.215.101"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_target_ipv4", "88.99.215.101"),
                    resource.TestCheckResourceAttr("data.allinkl_ddns.provider_test", "dyndns_target_ipv6", ""),
                ),
            },
        },
    })
}
